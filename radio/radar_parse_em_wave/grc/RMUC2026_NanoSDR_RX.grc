    comment: ''
    value: '940000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 12.0
    rotation: 0
    state: enabled
- name: rx_int_fir_taps
  id: variable
