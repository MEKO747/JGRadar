options:
  parameters:
    author: RMUC2026-NC
    catch_exceptions: 'True'
    category: '[RMUC2026-NC]'
    cmake_opt: ''
    comment: ''
    copyright: ''
    description: RMUC2026 receive-only radio with SIC and gain telemetry.
    gen_cmake: 'On'
    gen_linking: dynamic
    generate_options: no_gui
    hier_block_src_path: '.:'
    id: RMUC2026_NanoSDR_RX
    max_nouts: '0'
    output_language: python
    placement: (0,0)
    qt_qss_theme: ''
    realtime_scheduling: ''
    run: 'True'
    run_command: '{python} -u {filename}'
    run_options: run
    sizing_mode: fixed
    thread_safe_setters: ''
    title: RMUC2026 NanoSDR RX
    window_size: (1000,1000)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 8
    rotation: 0
    state: enabled
blocks:
- name: import_fft_window
  id: import
  parameters:
    imports: from gnuradio.fft import window
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 8
    - 164.0
    rotation: 0
    state: enabled
- name: bt
  id: variable
  parameters:
    comment: ''
    value: '0.35'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 328
    - 92.0
    rotation: 0
    state: enabled
- name: bw
  id: variable
  parameters:
    comment: ''
    value: '1000000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 248
    - 92.0
    rotation: 0
    state: enabled
- name: leak_beta_im
  id: variable
  parameters:
    comment: Info-channel leakage model coefficient imag part.
    value: '0.0'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1104
    - 92.0
    rotation: 0
    state: enabled
- name: leak_beta_re
  id: variable
  parameters:
    comment: Info-channel leakage model coefficient real part.
    value: '1'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1104
    - 12.0
    rotation: 0
    state: enabled
- name: loop_bw
  id: variable
  parameters:
    comment: 符号同步环路带宽。0.005 -> 0.01 依据 20261120 离线扫描 220 个参数点（均值 0.85 -> 0.89 包/kbit），待真实 2027 信号复测后定稿，见 docs/radio_tuning.md
    value: '0.01'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 48
    - 124.0
    rotation: 0
    state: enabled
- name: rx_center_freq
  id: variable
  parameters:
    comment: ''
    value: '432200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 560
    - 172.0
    rotation: 0
    state: enabled
- name: rx_gain
  id: variable
  parameters:
    comment: RX gain.
    value: '40'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 680
    - 172.0
    rotation: 0
    state: enabled
- name: rx_info_bw
  id: variable
  parameters:
    comment: ''
    value: '540000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1000
    - 92.0
    rotation: 0
    state: enabled
- name: rx_info_channel_freq
  id: variable
  parameters:
    comment: Selected information RX channel center.
    value: '433200000'
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 808
    - 92.0
    rotation: 0
    state: enabled
- name: rx_info_fir_taps
  id: variable
  parameters:
    comment: Retain both GFSK tones while rejecting the adjacent level-3 channel.
    value: firdes.low_pass(1, samp_rate, rx_info_bw/2 - 11000, 12000, window.WIN_KAISER, 8)
  states:
    bus_sink: false
    bus_source: false
    bus_structure: null
    coordinate:
    - 1216
    - 92.0
    rotation: 0
    state: enabled
- name: rx_int_bw
  id: variable
